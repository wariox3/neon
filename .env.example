# Origen del esquema OpenAPI del que se genera la referencia de la API.
# Acepta una ruta local o una URL http(s). Se lee SOLO en tiempo de compilación.
#
# Provisional (esquema de ejemplo incluido en el repo):
OPENAPI_SOURCE=./openapi/ejemplo.json
#
# Cuando Nobelio exponga su esquema real con drf-spectacular:
# OPENAPI_SOURCE=https://api.ejemplo.co/api/schema/?format=json
# OPENAPI_SOURCE=../nobelio/openapi.json

# URL base que se muestra en los ejemplos de la referencia y las guías.
# Si se deja vacía, se usa la del propio esquema (servers) o localhost.
# PUBLIC_API_BASE=https://api.ejemplo.co
