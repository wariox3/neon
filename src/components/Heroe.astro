---
/**
 * Sustituye al héroe de Starlight para poner el diagrama del flujo de emisión al
 * lado del titular. El de Starlight solo admite una imagen, y en móvil la coloca
 * encima del titular; aquí el diagrama va siempre después del texto.
 *
 * Lee los mismos campos del frontmatter (`hero.title`, `tagline` y `actions`), así
 * que la portada se sigue editando desde `index.mdx`. La estructura y las clases
 * son las del original, para que los estilos de `custom.css` sigan aplicando.
 */
import { LinkButton } from '@astrojs/starlight/components';
import FlujoEmision from './FlujoEmision.astro';

// El id del titular al que salta el enlace «Ir al contenido». Starlight lo define
// en `constants.ts`, pero no lo exporta.
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---

<div class="hero">
  <div class="sl-flex stack">
    <div class="sl-flex copy">
      <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
      {tagline && <div class="tagline" set:html={tagline} />}
    </div>
    {
      actions.length > 0 && (
        <div class="sl-flex actions">
          {actions.map(
            ({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
              <LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
                {text}
                {icon?.html && <Fragment set:html={icon.html} />}
              </LinkButton>
            )
          )}
        </div>
      )
    }
  </div>
  <FlujoEmision />
</div>

<style>
  /*
   * En la misma capa que el héroe original, para que `custom.css` —que no va en
   * ninguna capa— siga pudiendo ajustarlo.
   */
  @layer starlight.core {
    .hero {
      display: grid;
      align-items: center;
      gap: 2.5rem;
      padding-bottom: 1rem;
    }

    .stack {
      flex-direction: column;
      gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
      text-align: center;
    }

    .copy {
      flex-direction: column;
      gap: 1rem;
      align-items: center;
    }

    .copy > * {
      max-width: 50ch;
    }

    h1 {
      font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }

    .tagline {
      font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
      color: var(--sl-color-gray-2);
    }

    .actions {
      gap: 1rem 2rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    /*
     * Dos columnas a partir de 64rem y no de 50rem como el original: por debajo,
     * el diagrama queda tan estrecho que sus etiquetas se amontonan.
     */
    @media (min-width: 64rem) {
      .hero {
        grid-template-columns: 7fr 5fr;
        gap: 4rem;
        padding-block: clamp(2.5rem, calc(1rem + 10vmin), 10rem);
      }

      .stack {
        text-align: start;
      }

      .copy {
        align-items: flex-start;
      }

      .actions {
        justify-content: flex-start;
      }
    }
  }
</style>
