---
/**
 * Cascarón de las páginas del panel.
 *
 * Vive fuera de la colección `docs`, así que no hereda el diseño de Starlight;
 * sí reutiliza sus variables de color (`src/styles/custom.css`) para que el
 * panel y la documentación se vean del mismo sitio.
 *
 * La navegación completa se pinta solo cuando la página la pide. Las pantallas
 * de ingreso, registro y confirmación reciben en su lugar una cabecera mínima:
 * sin sesión no hay panel al que ir, pero sí hay que poder volver al sitio.
 */
import '../styles/custom.css';
import '../styles/panel.css';
import BarraPanel from '../components/app/BarraPanel.tsx';

interface Props {
  titulo: string;
  navegacion?: boolean;
}

const { titulo, navegacion = true } = Astro.props;
---

<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- El panel es privado: nada que indexar. -->
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Roboto, la tipografía del manual de marca. La misma que carga Starlight. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
    />
    <title>{titulo} · RedEDoc</title>
    <script is:inline>
      // Antes de pintar, para que no haya destello de tema claro. Es la misma
      // clave que usa Starlight, así que el tema se comparte con la documentación.
      // Starlight guarda 'light', 'dark' o 'auto'; 'auto' (y la ausencia de
      // valor) siguen al sistema.
      const guardado = localStorage.getItem('starlight-theme');
      const oscuro = guardado === 'dark' || guardado === 'light'
        ? guardado === 'dark'
        : window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
    </script>
  </head>
  <body>
    {navegacion ? (
      <BarraPanel client:only="react" />
    ) : (
      <header class="panel-barra">
        <a class="panel-barra__marca" href="/">RedEDoc</a>
        <nav class="panel-barra__enlaces">
          <a href="/">Volver al sitio</a>
        </nav>
      </header>
    )}
    <main class="panel-contenido">
      <slot />
    </main>
    <footer class="panel-pie">
      RedEDoc es un servicio de
      <a href="https://www.semantica.com.co" rel="noopener">Semántica Digital S.A.S.</a>
    </footer>
  </body>
</html>
